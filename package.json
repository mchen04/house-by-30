{
  "name": "house-by-30",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "predev": "pnpm generated-assets:build",
    "dev": "next dev",
    "prebuild": "pnpm generated-assets:build",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "ui:tokens:check": "tsx scripts/check-ui-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm tax-table-registry:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generated-assets:build": "pnpm tax-table-registry:build && pnpm service-worker:build",
    "service-worker:build": "node scripts/build-service-worker.mjs",
    "tax-table-registry:build": "node scripts/build-tax-table-registry.mjs",
    "tax:longevity-drill": "node scripts/longevity-drill.mjs",
    "tax:import-states": "tsx scripts/import-state-tax-table.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:density": "tsx scripts/seed-density-fixture.ts",
    "ui:density:measure": "node scripts/measure-density.mjs",
    "ui:alignment:measure": "node scripts/measure-alignment.mjs",
    "preverify": "pnpm generated-assets:build",
    "verify": "pnpm format:check && pnpm ui:tokens:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "0.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "color-name": "1.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.62.0",
    "postcss": "8.5.19",
    "postcss-custom-media": "12.0.1",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-preset-env": "11.3.2",
    "postcss-value-parser": "4.2.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
